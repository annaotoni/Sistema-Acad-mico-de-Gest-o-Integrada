NODE_ENV=development
PORT=3000

# Postgres — docker-compose na raiz do monorepo
DATABASE_URL="postgresql://auth:auth@localhost:5432/auth_system?schema=public"

# SMTP — Mailhog local (UI em http://localhost:8025). Em produção: Resend/SendGrid.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@sistema-academico.local

# Front-end
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Redis — ThrottlerModule, blocklist de tokens, cache de features (SettingsService), filas BullMQ.
# Em produção: redis://:senha@host:6379
REDIS_URL=redis://localhost:6379

# JWT — mínimo 32 caracteres.
# Gerar: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=

# Asaas — gateway de pagamento (Pix + boleto).
# Sandbox: https://sandbox.asaas.com  |  Produção: https://api.asaas.com/api/v3
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# LLM — assistente/chatbot interno.
# Provider: openai | anthropic
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
