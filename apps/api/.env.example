NODE_ENV=development
PORT=3000

# Postgres — docker-compose na raiz do monorepo (porta 5433 para não conflitar com auth-system)
DATABASE_URL="postgresql://academico:academico@localhost:5433/sistema_academico?schema=public"

# SMTP — Mailhog local (UI em http://localhost:8026). Em produção: Resend/SendGrid.
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@sistema-academico.local

# Front-end
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Redis — ThrottlerModule, blocklist de tokens, cache de features (SettingsService), filas BullMQ.
# Em produção: redis://:senha@host:6379  (porta 6380 local para não conflitar com auth-system)
REDIS_URL=redis://localhost:6380

# JWT — mínimo 32 caracteres.
# Gerar: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Asaas — gateway de pagamento (Pix + boleto).
# Sandbox: https://sandbox.asaas.com  |  Produção: https://api.asaas.com/api/v3
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=
# Mínimo 32 caracteres quando definido. Gerar: node -e "console.log(require('crypto').randomBytes(24).toString('base64'))"
ASAAS_WEBHOOK_TOKEN=

# LLM — assistente/chatbot interno (provider Anthropic).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
